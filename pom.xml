<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.workflowsim</groupId>
    <artifactId>workflowsim-parent</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <name>WorkflowSim Parent</name>
    <description>
        WorkflowSim 的 Maven Reactor 父工程。稳定模拟器位于 simulator/；
        教学、参考基线和研究实验位于 experiments/ 模块。
    </description>

    <!-- 默认构建模拟器和实验模块。 -->
    <modules>
        <module>simulator</module>
        <module>experiments</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.minimum.version>3.6.3</maven.minimum.version>
        <maven.build.java.version>17</maven.build.java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <workflowsim.javadoc.skip>true</workflowsim.javadoc.skip>
        <workflowsim.simulator.exec.skip>true</workflowsim.simulator.exec.skip>
        <workflowsim.experiments.exec.skip>false</workflowsim.experiments.exec.skip>
        <!-- JaCoCo 在生命周期中写入；默认空值使直接 Surefire/Failsafe 调用安全。 -->
        <argLine></argLine>
    </properties>

    <build>
        <plugins>
            <!-- Reactor 聚合根没有运行时类路径；显式跳过直接调用的 exec:java。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <excludes>
                            <exclude>**/*IntegrationTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                    <executions>
                        <execution>
                            <id>run-integration-tests</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <includes>
                            <include>**/*IntegrationTest.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <execution>
                            <id>enforce-build-toolchain</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>[${maven.minimum.version},)</version>
                                        <message>WorkflowSim requires Maven ${maven.minimum.version} or newer.</message>
                                    </requireMavenVersion>
                                    <requireJavaVersion>
                                        <version>[${maven.build.java.version},)</version>
                                        <message>WorkflowSim requires a JDK ${maven.build.java.version} or newer to build.</message>
                                    </requireJavaVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.1</version>
                    <executions>
                        <execution>
                            <id>build-javadoc-compile-classpath</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>build-classpath</goal>
                            </goals>
                            <configuration>
                                <skip>${workflowsim.javadoc.skip}</skip>
                                <includeScope>compile</includeScope>
                                <outputProperty>workflowsim.javadoc.dependencyClasspath</outputProperty>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <executions>
                        <execution>
                            <id>prepare-unit-coverage</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>prepare-integration-coverage</id>
                            <goals>
                                <goal>prepare-agent-integration</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report-unit-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <formats>
                                    <format>HTML</format>
                                    <format>XML</format>
                                </formats>
                            </configuration>
                        </execution>
                        <execution>
                            <id>report-integration-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report-integration</goal>
                            </goals>
                            <configuration>
                                <formats>
                                    <format>HTML</format>
                                    <format>XML</format>
                                </formats>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <executions>
                        <execution>
                            <id>generate-maintained-api</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>javadoc</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <skip>${workflowsim.javadoc.skip}</skip>
                        <source>${maven.compiler.release}</source>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <docencoding>${project.build.sourceEncoding}</docencoding>
                        <charset>${project.build.sourceEncoding}</charset>
                        <show>protected</show>
                        <disableSourcepathUsage>true</disableSourcepathUsage>
                        <sourceFileExcludes>
                            <sourceFileExclude>**/org/cloudbus/**</sourceFileExclude>
                        </sourceFileExcludes>
                        <additionalOptions>
                            <additionalOption>-classpath</additionalOption>
                            <additionalOption>${project.build.outputDirectory}${path.separator}${workflowsim.javadoc.dependencyClasspath}</additionalOption>
                        </additionalOptions>
                        <tags>
                            <tag>
                                <name>date</name>
                                <placement>a</placement>
                                <head>日期:</head>
                            </tag>
                            <tag>
                                <name>pre</name>
                                <placement>a</placement>
                                <head>前置条件:</head>
                            </tag>
                            <tag>
                                <name>post</name>
                                <placement>a</placement>
                                <head>后置条件:</head>
                            </tag>
                        </tags>
                        <doclint>all,-missing</doclint>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>javadoc</id>
            <properties>
                <workflowsim.javadoc.skip>false</workflowsim.javadoc.skip>
            </properties>
        </profile>
        <profile>
            <id>core-exec</id>
            <properties>
                <workflowsim.simulator.exec.skip>false</workflowsim.simulator.exec.skip>
            </properties>
        </profile>
    </profiles>
</project>
