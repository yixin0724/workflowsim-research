<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.workflowsim</groupId>
        <artifactId>workflowsim-parent</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>workflowsim-experiments</artifactId>
    <packaging>jar</packaging>
    <name>WorkflowSim Experiments</name>
    <description>WorkflowSim 的教学示例、冻结参考基线和未来研究实验资产。</description>

    <properties>
        <!-- R3 覆盖率门禁棘轮值：略低于实测（2026-09-16 R9 清理轮 clean verify：
             instruction 33.78% / branch 35.58%；R9 常驻语料守门后 3 个 corpus
             测试在标准构建实跑（0 跳过），不再因语料缺失压低覆盖率），只升不降。 -->
        <workflowsim.jacoco.instruction.minimum>0.33</workflowsim.jacoco.instruction.minimum>
        <workflowsim.jacoco.branch.minimum>0.35</workflowsim.jacoco.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.workflowsim</groupId>
            <artifactId>workflowsim</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <workflowsim.datasetRoot>${project.parent.basedir}/datasets</workflowsim.datasetRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <workflowsim.datasetRoot>${project.parent.basedir}/datasets</workflowsim.datasetRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>${workflowsim.experiments.exec.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
